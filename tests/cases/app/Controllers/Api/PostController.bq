namespace App\Controllers\Api

use App\Models\Post
use App\Requests\StorePostRequest
use App\Resources\PostResource

class PostController

    #[Public]
    #[list<dict<string, any>>]
    karo index()
        return PostResource.collection(Post.with("user").orderBy("id").get())

    #[Public]
    #[PostResource]
    karo show(Post post)
        return new PostResource(post)

    #[Public]
    #[PostResource]
    karo store(StorePostRequest request)
        Post post = Post.create(request.validated())
        return new PostResource(post)

    #[Public]
    #[Post]
    karo raw(int id)
        return Post.findOrFail(id)
