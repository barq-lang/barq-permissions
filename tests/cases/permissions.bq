// Roles and permissions (barq/permissions, built in since v0.16)
use App\Models\User
use App\Models\Team
use Barq\Permissions\Role
use Barq\Permissions\Permission

Database db = Database.connect("sqlite", #{"path": ":memory:"})
Model.useConnection(db)
db.schema().create("users", karo(Blueprint t): void
    t.id()
    t.string("name")
    t.string("email").unique()
    t.string("password").nullable()
    t.int("age").nullable()
    t.bool("active").default(true)
    t.int("current_team_id").nullable()
    t.rememberToken()
    t.timestamps()
)
db.schema().create("teams", karo(Blueprint t): void
    t.id()
    t.int("user_id")
    t.string("name")
    t.timestamps()
)
db.schema().create("team_members", karo(Blueprint t): void
    t.id()
    t.int("team_id")
    t.int("user_id")
    t.string("role").nullable()
    t.timestamps()
)

Config.set("auth.providers.users.model", User)
Config.set("auth.teams.model", Team)

User ali = User.create(#{"name": "Ali", "email": "ali@shop.test"})
User sara = User.create(#{"name": "Sara", "email": "sara@shop.test"})
User omar = User.create(#{"name": "Omar", "email": "omar@shop.test"})

// ---- before the tables exist ---------------------------------------------------
print("== no tables")
print(ali.can("edit posts"), Gate.forUser(ali).allows("edit posts"))
try
    Role.create("admin")
except PermissionException as e
    print("PermissionException:", str_before(e.message, " —"))
print(Permissions.tables())

// the tables, as barq permissions:install writes them
db.schema().create("permissions", karo(Blueprint t): void
    t.id()
    t.string("name")
    t.string("guard_name")
    t.timestamps()
    t.unique(#["name", "guard_name"])
)
db.schema().create("roles", karo(Blueprint t): void
    t.id()
    t.string("name")
    t.string("guard_name")
    t.timestamps()
    t.unique(#["name", "guard_name"])
)
db.schema().create("role_has_permissions", karo(Blueprint t): void
    t.int("permission_id")
    t.int("role_id").index()
    t.unique(#["permission_id", "role_id"])
)
db.schema().create("model_has_roles", karo(Blueprint t): void
    t.int("role_id").index()
    t.morphs("model")
    t.int("team_id").nullable().index()
)
db.schema().create("model_has_permissions", karo(Blueprint t): void
    t.int("permission_id").index()
    t.morphs("model")
    t.int("team_id").nullable().index()
)

// ---- creating ---------------------------------------------------------------------
print("== create")
for name in #["view posts", "create posts", "edit posts", "delete posts", "publish posts", "view users"]
    Permission.create(name)
Permission p = Permission.create("posts.*")
print(p.name, p.guard_name, p.id, p is Permission, p is Model)
Role admin = Role.create("admin")
Role editor = Role.create(#{"name": "editor"})
Role writer = Role.findOrCreate("writer")
print(admin.name, editor.guard_name, writer.id, Role.findOrCreate("writer").id, Role.count(), Permission.count())
Role apiAdmin = Role.create("admin", "api")
print(apiAdmin.guard_name, Role.names(), Role.names("api"))
try
    Role.create("admin")
except PermissionException as e
    print("PermissionException:", e.message)
try
    Role.findByName("nobody")
except PermissionException as e
    print("PermissionException:", e.message)
print(Role.findByName("admin").id == admin.id, Role.findByName("admin", "api").id == apiAdmin.id, Role.findById(editor.id).name)
print(Role.where("guard_name", "web").pluck("name"))
Permission fc = Permission.firstOrCreate(#{"name": "manage settings"})
print(fc.guard_name, Permission.firstOrCreate(#{"name": "manage settings"}).id == fc.id)

// ---- roles get permissions -------------------------------------------------------
print("== role permissions")
admin.givePermissionTo("view posts")
admin.givePermissionTo("create posts", "edit posts")
admin.givePermissionTo(#["delete posts", "publish posts", "view users"])
editor.givePermissionTo(#["view posts", "create posts", "edit posts", "publish posts"]).givePermissionTo("view posts")
writer.syncPermissions(#["view posts", "create posts", "edit posts"])
print(admin.getPermissionNames())
print(editor.getPermissionNames(), editor.hasPermissionTo("publish posts"), editor.hasPermissionTo("delete posts"))
writer.syncPermissions(#["view posts", "edit posts"])
writer.revokePermissionTo("edit posts")
print(writer.getPermissionNames(), list_map(writer.permissions().get(), kr(Permission x): string => x.name))
print(Permission.findByName("edit posts").getRoleNames(), Permission.findByName("view posts").roles().count())
Permission.findByName("view users").assignRole("editor")
print(editor.hasPermissionTo("view users"))
Permission.findByName("view users").removeRole(editor)
print(editor.hasPermissionTo("view users"))
try
    apiAdmin.givePermissionTo("view posts")
except PermissionException as e
    print("PermissionException:", e.message)

// ---- users get roles --------------------------------------------------------------
print("== user roles")
ali.assignRole("admin")
sara.assignRole(#["editor", "writer"])
omar.assignRole(writer)
print(ali.hasRole("admin"), ali.hasRole("editor"), sara.hasRole(#["editor", "writer"]), sara.hasRole(#["editor", "admin"]))
print(sara.hasAnyRole(#["admin", "editor"]), sara.hasAllRoles(#["editor", "writer"]), sara.hasAllRoles(#["admin", "editor"]))
print(sara.getRoleNames(), list_map(sara.roles().get(), kr(Role r): string => r.name), sara.roles().count())
print(ali.hasRole("admin", "api"), ali.hasRole("admin", guard: "web"), ali.hasRole(admin), ali.hasRole(apiAdmin))
sara.removeRole("writer")
print(sara.getRoleNames())
sara.syncRoles(#["writer", "admin"])
print(sara.getRoleNames())
sara.syncRoles("editor")
print(sara.getRoleNames())
omar.roles().detach()
print(omar.getRoleNames(), omar.hasAnyRole(#["writer"]))
omar.assignRole("writer", "writer")
print(omar.roles().count(), list_map(admin.users().get(), kr(User u): string => u.name), writer.users().count())
try
    ali.assignRole("ghost")
except PermissionException as e
    print("PermissionException:", e.message)
User nobody = new User(#{"name": "Nobody", "email": "no@shop.test"})
try
    nobody.assignRole("admin")
except PermissionException as e
    print("PermissionException:", e.message)
print(nobody.can("view posts"))

// ---- users get permissions ----------------------------------------------------------
print("== user permissions")
omar.givePermissionTo("delete posts")
print(omar.hasPermissionTo("delete posts"), omar.hasDirectPermission("delete posts"), omar.hasPermissionViaRole("delete posts"))
print(omar.hasPermissionTo("view posts"), omar.hasDirectPermission("view posts"), omar.hasPermissionViaRole("view posts"))
print(omar.getPermissionNames(), omar.getDirectPermissions().len(), list_map(omar.getPermissionsViaRoles(), kr(Permission x): string => x.name))
print(list_map(omar.getAllPermissions(), kr(Permission x): string => x.name))
print(omar.hasAnyPermission(#["publish posts", "delete posts"]), omar.hasAllPermissions(#["publish posts", "delete posts"]))
omar.syncPermissions(#["publish posts"])
omar.revokePermissionTo("publish posts")
omar.revokePermissionTo("never made")
print(omar.getDirectPermissions().len(), omar.permissions().count(), omar.hasPermissionTo("never made"))
omar.givePermissionTo(Permission.findByName("publish posts"))
print(omar.hasDirectPermission("publish posts"))

// ---- the Gate ---------------------------------------------------------------------
print("== gate")
print(ali.can("delete posts"), sara.can("delete posts"), sara.cannot("delete posts"), omar.can("publish posts"))
print(Gate.forUser(sara).allows("publish posts"), Gate.forUser(sara).any(#["delete posts", "edit posts"]))
Gate.define("delete posts", kr(User u): bool => u.name == "Sara")
print(sara.can("delete posts"), omar.can("delete posts"), ali.can("delete posts"))
Gate.define("archive", kr(User u): bool => false)
print(ali.can("archive"))

// wildcards
print("== wildcards")
Permission.create("users.*")
Permission.create("reports.view")
Role support = Role.create("support")
support.givePermissionTo("users.*", "reports.view")
User zara = User.create(#{"name": "Zara", "email": "zara@shop.test"})
zara.assignRole("support")
print(zara.can("users.create"), zara.can("users.delete"), zara.can("users"), zara.can("reports.view"), zara.can("reports.edit"))
print(zara.hasPermissionTo("users.ban.forever"), support.hasPermissionTo("users.edit"), Permissions.matches("*", "any.thing"))
zara.givePermissionTo("posts.*")
print(zara.can("posts.create"), zara.hasDirectPermission("posts.publish"), zara.hasPermissionViaRole("posts.publish"))
Config.set("permissions.wildcards", false)
print(zara.can("users.create"), zara.can("users.*"))
Config.set("permissions.wildcards", true)

// super admin
print("== super admin")
Role.create("super-admin")
User boss = User.create(#{"name": "Boss", "email": "boss@shop.test"})
boss.assignRole("super-admin")
print(boss.can("destroy the world"), boss.getPermissionNames())
Config.set("permissions.super_admin_role", "super-admin")
print(boss.can("destroy the world"), boss.can("archive"), Gate.forUser(boss).check(#["a", "b"]), Permissions.superAdminRole())

// ---- teams -------------------------------------------------------------------------
print("== teams")
Team acme = Team.create(#{"name": "Acme", "user_id": ali.id})
Team beta = Team.create(#{"name": "Beta", "user_id": ali.id})
omar.assignRole("editor", team: acme)
print(omar.hasRole("editor", team: acme), omar.hasRole("editor", team: beta), omar.hasRole("editor"))
print(omar.getRoleNames(acme), omar.getRoleNames(), omar.roles(acme).count(), omar.roles(team: beta).count())
print(omar.can("edit posts", team: acme), omar.can("edit posts", team: beta), omar.can("edit posts"))
print(omar.can("view posts", team: beta), "(writer has no team, so it counts everywhere)")
omar.givePermissionTo("manage settings", team: beta)
print(omar.can("manage settings", team: beta), omar.can("manage settings", team: acme), omar.hasPermissionTo("manage settings", team: beta))
print(omar.getPermissionNames(beta))
omar.removeRole("editor", team: acme)
print(omar.hasRole("editor", team: acme))
omar.assignRole("editor", team: acme.id)
print(omar.hasRole("editor", team: acme))
acme.delete()
print(omar.hasRole("editor", team: acme.id), "(deleting a team removes its assignments)")

// ---- deleting ---------------------------------------------------------------------
print("== delete")
print(Role.count(), Permission.count())
writer.delete()
print(Role.count(), omar.getRoleNames(), Permission.findByName("view posts").getRoleNames())
Permission.findByName("edit posts").delete()
print(admin.getPermissionNames().len(), sara.hasPermissionTo("edit posts"))
zara.delete()
print(db.table("model_has_roles").where("model_id", zara.id).count())

// ---- cache ------------------------------------------------------------------------
print("== cache")
db.table("roles").insert(#{"name": "sneaky", "guard_name": "web"})
print("sneaky" in Role.names())
app("barq.permissions.cache").forget()
print("sneaky" in Role.names())
db.table("roles").where("name", "sneaky").delete()
print(Permissions.forgetCache(), "sneaky" in Role.names())

// ---- middleware -------------------------------------------------------------------
print("== middleware")
Route.get("/admin", kr(): string => "admin area").middleware("role:admin")
Route.get("/content", kr(): string => "content").middleware("role:admin|editor")
Route.get("/publish", kr(): string => "publish").middleware("permission:publish posts")
Route.get("/either", kr(): string => "either").middleware("role_or_permission:admin|delete posts")
Route.get("/api-admin", kr(): string => "api admin").middleware("role:admin,api")
for path in #["/admin", "/content", "/publish", "/either", "/api-admin"]
    list<string> out = #[]
    for u in #[ali, sara, omar, boss]
        out.push(to_str(new TestClient().actingAs(u).get(path).status))
    print(path, out, new TestClient().get(path, #{"headers": #{"Accept": "application/json"}}).status)
print(new TestClient().actingAs(sara).get("/admin", #{"headers": #{"Accept": "application/json"}}).json()["message"])
ali.assignRole(apiAdmin)
print(ali.getRoleNames(), ali.hasRole("admin", "api"), new TestClient().actingAs(ali, "api").get("/api-admin").status,
      new TestClient().actingAs(sara, "api").get("/api-admin").status)

print("== errors")
try
    ali.hasRole(42.5)
except TypeException as e
    print("TypeException:", e.message)
try
    ali.assignRole("admin", team: "x", guard: "web")
except TypeException as e
    print("TypeException:", e.message)
try
    admin.givePermissionTo(true)
except TypeException as e
    print("TypeException:", e.message)
Config.set("auth.guards.admin", #{"driver": "session", "provider": "admins"})
Config.set("auth.providers.admins", #{"driver": "orm", "model": Team})
Role teamRole = Role.create("auditor", "admin")
try
    sara.assignRole(teamRole)
except PermissionException as e
    print("PermissionException:", e.message)

// any model can have roles; `use HasRoles` is there for readers
print("== HasRoles")
class Staff extends Model
    use HasRoles

db.schema().create("staffs", karo(Blueprint t): void
    t.id()
    t.string("name")
    t.timestamps()
)
Staff s = Staff.create(#{"name": "Kim"})
s.assignRole(editor)
print(s.getRoleNames(), s.can("publish posts"), list_map(editor.users(Staff).get(), kr(Staff x): string => x.name), editor.users().count())
